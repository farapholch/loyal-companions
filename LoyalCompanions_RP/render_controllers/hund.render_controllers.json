{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.hund": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "mun_boll": "q.property('hund:bar') == 1"
        },
        {
          "mun_pinne": "q.property('hund:bar') == 2"
        },
        {
          "mun_ben": "q.property('hund:bar') == 3"
        }
      ]
    }
  }
}