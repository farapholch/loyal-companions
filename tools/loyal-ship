#!/bin/bash
# Bygg → testa → paketera → skicka till Mod Mate, i ett kommando.
# Vägrar skicka om loyal-test hittar fel.
#
# Användning:  tools/loyal-ship                 # testa + paketera + ladda upp (familjen)
#              tools/loyal-ship --bump minor    # höj version (major|minor|patch) först
#              tools/loyal-ship --public        # publika varianten
#              tools/loyal-ship --no-upload     # bygg + testa, men skicka inte
#              tools/loyal-ship --curseforge    # publicera på CurseForge (BARA på order)
set -u
SRC=/opt/loyal-companions
BUMP=""; UPLOAD=1; VARIANT="private"; CURSEFORGE=0
# Token:en är knuten till FÖRFATTARKONTOT, inte till projektet — kattpaketets
# duger lika bra om hundprojektet inte har en egen fil.
CF_TOKEN_FILE="$SRC/.curseforge-token"
[ -f "$CF_TOKEN_FILE" ] || CF_TOKEN_FILE=/opt/purrfect-companions/.curseforge-token
CF_PROJECT_FILE="$SRC/.curseforge-project"
CF_API=https://bedrock.curseforge.com/api
while [ $# -gt 0 ]; do
  case "$1" in
    --bump) case "${2:-}" in major|minor|patch) BUMP="$2"; shift 2;; *) BUMP=patch; shift;; esac;;
    --no-upload) UPLOAD=0; shift;;
    --public) VARIANT="public"; shift;;
    --private) VARIANT="private"; shift;;
    --curseforge) CURSEFORGE=1; VARIANT="public"; shift;;
    *) echo "okänt argument: $1"; exit 1;;
  esac
done

if [ -n "$BUMP" ]; then
  python3 - "$SRC" "$BUMP" <<'PY'
import json, sys
SRC, kind = sys.argv[1], sys.argv[2]
BP = f"{SRC}/LoyalCompanions_BP/manifest.json"; RP = f"{SRC}/LoyalCompanions_RP/manifest.json"
bp = json.load(open(BP)); rp = json.load(open(RP))
v = list(bp["header"]["version"]); i = {"major": 0, "minor": 1, "patch": 2}[kind]
v[i] += 1
for j in range(i + 1, 3): v[j] = 0
for m in (bp, rp):
    m["header"]["version"] = v
    for mod in m["modules"]: mod["version"] = v
for d in bp.get("dependencies", []):
    if d.get("uuid") == rp["header"]["uuid"]: d["version"] = v
json.dump(bp, open(BP, "w"), indent=2); json.dump(rp, open(RP, "w"), indent=2)
print("ny version: " + ".".join(map(str, v)))
PY
fi

VER=$(python3 -c "import json;print('.'.join(map(str,json.load(open('$SRC/LoyalCompanions_BP/manifest.json'))['header']['version'])))")

echo "=== testar v$VER ($VARIANT) innan leverans ==="
if ! "$SRC/tools/loyal-test"; then
  echo; echo "❌ TESTET FAILADE — skickar INTE. Fixa felen och kör igen."
  exit 1
fi

STAGE="/tmp/loyal-stage-$VARIANT"
python3 "$SRC/make_variant.py" "$VARIANT" "$STAGE" | sed 's/^/   /'
SLUG=$(python3 -c "
import json,re
n=json.load(open('$STAGE/LoyalCompanions_BP/manifest.json'))['header']['name']
print(re.sub(r'[^a-z0-9]+','-',n.lower()).strip('-'))")
OUT="/tmp/$SLUG-v$VER.mcaddon"
rm -f "$OUT"
( cd "$STAGE" && zip -r -q "$OUT" LoyalCompanions_BP LoyalCompanions_RP )
SHA=$(sha256sum "$OUT" | cut -d' ' -f1)

# PRIVATA NAMN I PUBLIK FIL. Kattpaketets publika .mcaddon bar familjens namn i
# KOMMENTARER i main.js — osynligt i spelet, fullt läsbart för den som packar
# upp filen. Namnen läses ur variants.private.json, så listan kan inte bli
# gammal när en hund byter namn.
if [ "$VARIANT" = "public" ]; then
  LACKA=$(python3 - "$OUT" "$SRC" <<'PYNAMN'
import json, os, sys, zipfile
fil, src = sys.argv[1], sys.argv[2]
pf = f"{src}/variants.private.json"
namn = set()
if os.path.exists(pf):
    for cfg in json.load(open(pf, encoding="utf-8")).values():
        for slug, disp in (cfg.get("names") or {}).values():
            namn |= {slug.lower(), disp.lower()}
z = zipfile.ZipFile(fil); traff = []
for n in z.namelist():
    if n.endswith((".json", ".lang", ".js", ".txt", ".md")):
        d = z.read(n).decode("utf-8", "ignore").lower()
        traff += [f"{n}: {p}" for p in namn if p in d]
print("\n".join(traff))
PYNAMN
)
  if [ -n "$LACKA" ]; then
    echo "❌ AVBRYTER: privata hundnamn i den publika filen"
    echo "$LACKA" | sed 's/^/   /'
    exit 1
  fi
  echo "🔒 inga privata namn i den publika filen"
fi
echo "📦 paketerad: $(basename "$OUT") ($(du -h "$OUT" | cut -f1))"

# Två filer med samma pack-uuid OCH samma version men olika innehåll får
# Minecraft att vägra ladda den ena. Loggboken gör om det till ett stopp.
# Zip-arkiv är inte reproducerbara (tidsstämplar), så arkivets sha duger inte
# för att avgöra om innehållet ändrats — filerna hashas i stället.
LEDGER="$SRC/.shipped.tsv"
CONTENT_SHA=$(cd "$STAGE" && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -d" " -f1)
if PREV=$(grep -P "^$VER\t$VARIANT\t" "$LEDGER" 2>/dev/null | tail -1 | cut -f3); [ -n "$PREV" ]; then
  if [ "$PREV" != "$CONTENT_SHA" ]; then
    echo "❌ v$VER ($VARIANT) är redan utskickad med ANNAT innehåll"
    echo "   Höj versionen (--bump patch) — skicka aldrig samma version två gånger."
    exit 1
  fi
  echo "   (samma innehåll som redan utskickad v$VER — skickar om)"
fi

if [ "$CURSEFORGE" -eq 1 ]; then
  # CURSEFORGE PUBLICERAS BARA PÅ UTTRYCKLIG ORDER. Flaggan ÄR ordern; det här
  # skriptet får aldrig köras med --curseforge på eget bevåg. Projekt-ID:t
  # ligger i en egen fil som inte finns förrän Pelle skapat projektet, så ett
  # slarvigt körkommando stannar här i stället för att ladda upp någonstans.
  [ -f "$CF_PROJECT_FILE" ] || { echo "❌ inget projekt-ID i $CF_PROJECT_FILE — skapa projektet på CurseForge först"; exit 1; }
  [ -f "$CF_TOKEN_FILE" ] || { echo "❌ ingen CurseForge-token i $CF_TOKEN_FILE"; exit 1; }
  CF_PROJECT=$(tr -d '[:space:]' < "$CF_PROJECT_FILE")
  METAFILE=/tmp/loyal-cf-metadata.json
  python3 - "$VER" "$METAFILE" "$SRC" <<'PYMETA'
import json, sys
ver, ut, src = sys.argv[1], sys.argv[2], sys.argv[3]
# BARA NYASTE POSTEN. Kattprojektet skickade hela changeloggen och fick 500
# "unhandled exception" vid 28 452 tecken två gånger i rad. En release-not ska
# ändå handla om just den releasen.
# BUTIKENS SPRÅK ÄR ENGELSKA. CHANGELOG.md är projektets egen logg och är på
# svenska; publish/release-notes.md är samma historia för läsaren på
# butikssidan. Skickas fel fil står det svenska på en engelsk produktsida.
full = open(f"{src}/publish/release-notes.md", encoding="utf-8").read()
senaste = full.split("\n## ")[1] if "\n## " in full else full
kort = "## " + senaste.split("\n## ")[0].rstrip()
json.dump({"changelog": kort, "changelogType": "markdown",
           "displayName": f"Loyal Companions {ver}", "releaseType": "release"},
          open(ut, "w", encoding="utf-8"))
print(f"   metadata: {len(kort)} tecken changelog")
PYMETA
  echo "☁️  laddar upp till CurseForge-projekt $CF_PROJECT ..."
  # OBS: gameVersions ska INTE skickas för Bedrock-projekt — API:et svarar
  # "Invalid game version ID ... belongs to an invalid game". Java kräver det.
  RESP=$(curl -s --max-time 180 -X POST \
    -H "X-Api-Token: $(cat "$CF_TOKEN_FILE")" \
    -F "metadata=<$METAFILE" -F "file=@$OUT" \
    "$CF_API/projects/$CF_PROJECT/upload-file")
  echo "   svar: $RESP"
  echo "$RESP" | grep -q '"id"' && echo "✅ uppladdad till CurseForge" || { echo "❌ CurseForge-uppladdningen misslyckades"; exit 1; }
  printf '%s\t%s\t%s\n' "$VER" "curseforge" "$CONTENT_SHA" >> "$LEDGER"
  exit 0
fi

[ "$UPLOAD" -eq 0 ] && { echo "(--no-upload: hoppar över Mod Mate)"; exit 0; }

# Mod Mate-koden är knuten till appen, inte till projektet — kattpaketets kod
# duger lika bra om hundprojektet inte har en egen.
CODE_FILE="$SRC/.modmate-code"
[ -f "$CODE_FILE" ] || CODE_FILE=/opt/purrfect-companions/.modmate-code
if [ ! -f "$CODE_FILE" ]; then
  echo "❌ ingen Mod Mate-kod sparad. Lägg transfer-koden i $SRC/.modmate-code"
  exit 1
fi
CODE=$(tr -d '[:space:]' < "$CODE_FILE")
RESP=$(curl -s --max-time 120 -X POST -F "file=@$OUT;type=application/octet-stream" \
  "https://modmate.dev/ModMateTransfer/upload?code=$CODE")
echo "☁️  Mod Mate: $RESP"
if echo "$RESP" | grep -q "$SHA"; then
  echo "✅ checksumma verifierad — filen kom fram intakt"
  printf '%s\t%s\t%s\n' "$VER" "$VARIANT" "$CONTENT_SHA" >> "$LEDGER"
else
  echo "⚠️  checksumman i svaret matchar inte lokal fil ($SHA) — kontrollera manuellt"
  exit 1
fi
