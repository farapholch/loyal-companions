#!/bin/bash
# Testkedja för Loyal Companions. Samma upplägg som purrfect-test, men bara de
# lager som ett ungt paket behöver: statisk validering och en skarp
# serverkörning. GameTest och nätverksbot läggs till när det finns mekanik
# värd att prova med dem.
#
# EN Bedrock-server åt gången — samma lås som kattpaketet, annars krockar de
# på portarna när båda testas.
set -u
if [ "${BDS_LOCK_HELD:-}" != "1" ]; then
  exec 9>/tmp/bds.lock; flock -w 1200 9 || { echo "kunde inte ta serverlåset"; exit 1; }
  export BDS_LOCK_HELD=1
fi
SRC=/opt/loyal-companions
SRV=/opt/bds/server
WORLD="$SRV/worlds/Hundtest"
LOG=/tmp/loyal-test.log
# RASERNA LÄSES UR PAKETET, inte ur en lista här. Peach lades till och
# testades inte — raden sa fortfarande "3/3" och såg grön ut. Kattprojektet
# gick i exakt den fällan tre gånger (spawnägg som raderades, katter som
# aldrig provades), och det är alltid samma orsak: två ställen som ska hållas
# i synk, varav bara ett underhålls.
RASER=$(ls "$SRC/LoyalCompanions_BP/entities/"*.json | xargs -n1 basename | sed 's/\.json$//' | tr '\n' ' ')
ANTAL=$(echo $RASER | wc -w)
FAIL=0
ok(){ echo "  ✅ $1"; }
bad(){ echo "  ❌ $1"; FAIL=1; }

echo "=== Loyal Companions-test $(date '+%F %H:%M') ==="
echo
echo "[1/3] JSON och bilder"
n=0
while read -r f; do
  n=$((n+1))
  python3 -c "import json;json.load(open('$f'))" 2>/dev/null || bad "ogiltig JSON: ${f#$SRC/}"
done < <(find "$SRC" -name "*.json")
[ $FAIL -eq 0 ] && ok "$n JSON-filer giltiga"
python3 /opt/purrfect-companions/tools/pngkoll.py "$SRC/LoyalCompanions_RP" | sed 's/^/  /' || bad "trasiga PNG-filer"

echo
echo "[2/3] Struktur"
STRUKT=$(python3 - "$SRC" <<'PY'
import json, glob, os, re, struct, sys
SRC = sys.argv[1]; bad = []
bp = json.load(open(f"{SRC}/LoyalCompanions_BP/manifest.json"))
rp = json.load(open(f"{SRC}/LoyalCompanions_RP/manifest.json"))
if bp["header"]["version"] != rp["header"]["version"]: bad.append("BP- och RP-version skiljer")
# MOTORKRAVET måste räcka till de format_version vi faktiskt använder, annars
# ber paketet om en motor som inte kan läsa dess egna filer.
mev = tuple(bp["header"].get("min_engine_version", [0, 0, 0]))
for f in glob.glob(f"{SRC}/LoyalCompanions_BP/**/*.json", recursive=True):
    d = json.load(open(f))
    # world_*_packs.json och liknande är listor, inte objekt
    fv = d.get("format_version") if isinstance(d, dict) else None
    if not isinstance(fv, str):
        continue
    delar = tuple(int(x) for x in fv.split(".")[:3]) + (0,) * (3 - len(fv.split(".")[:3]))
    if delar > mev:
        bad.append(f"{os.path.basename(f)}: format_version {fv} > min_engine_version "
                   f"{'.'.join(map(str, mev))}")
dep = [d for d in bp.get("dependencies", []) if d.get("uuid") == rp["header"]["uuid"]]
if not dep: bad.append("BP saknar beroende till RP")
# geometrins texturstorlek måste stämma med PNG:en — annars läses UV i fel
# skala och modellen blir obegriplig, utan att servern märker något
geo = json.load(open(f"{SRC}/LoyalCompanions_RP/models/entity/hund.geo.json"))["minecraft:geometry"][0]
BEN = {b["name"] for b in geo["bones"]}
KRAV = {"animation.common.look_at_target": ["head"],
        "animation.quadruped.walk": ["leg0", "leg1", "leg2", "leg3"]}
itex = json.load(open(f"{SRC}/LoyalCompanions_RP/textures/item_texture.json"))["texture_data"]
for f in sorted(glob.glob(f"{SRC}/LoyalCompanions_RP/entity/*.json")):
    d = json.load(open(f))["minecraft:client_entity"]["description"]
    namn = os.path.basename(f)
    tex = f"{SRC}/LoyalCompanions_RP/{d['textures']['default']}.png"
    if not os.path.exists(tex): bad.append(f"{namn}: textur saknas"); continue
    tw, th = struct.unpack(">II", open(tex, "rb").read()[16:24])
    dsc = geo["description"]
    if (dsc.get("texture_width"), dsc.get("texture_height")) != (tw, th):
        bad.append(f"{namn}: geometrins texturstorlek != PNG {tw}x{th}")
    for anim in d.get("animations", {}).values():
        for krav in KRAV.get(anim, []):
            if krav not in BEN: bad.append(f"{namn}: {anim} kräver benet '{krav}'")
    agg = d.get("spawn_egg", {}).get("texture")
    if agg and agg not in itex: bad.append(f"{namn}: spawnägg '{agg}' saknas i item_texture.json")
    ident = d["identifier"]
    if not os.path.exists(f"{SRC}/LoyalCompanions_BP/entities/{ident.split(':')[1]}.json"):
        bad.append(f"{namn}: ingen beteendeentitet")
# RENDERARKONTROLLERN: hänvisar en klientdefinition till en kontroller som
# inte finns visas ingenting alls, och pekar part_visibility på ett bennamn som
# inte finns i geometrin tystnar raden — bollen i munnen skulle helt enkelt
# aldrig synas, utan ett ord i någon logg.
GEOBEN = set()
for geo in json.load(open(f"{SRC}/LoyalCompanions_RP/models/entity/hund.geo.json"))["minecraft:geometry"]:
    GEOBEN |= {b["name"] for b in geo["bones"]}
KTRL = {}
for f in glob.glob(f"{SRC}/LoyalCompanions_RP/render_controllers/*.json"):
    KTRL.update(json.load(open(f))["render_controllers"])
for namn, k in KTRL.items():
    for regel in k.get("part_visibility", []):
        for ben in regel:
            if ben != "*" and ben not in GEOBEN:
                bad.append(f"{namn}: part_visibility pekar på benet '{ben}' som geometrin saknar")
for f in sorted(glob.glob(f"{SRC}/LoyalCompanions_RP/entity/*.json")):
    d = json.load(open(f))["minecraft:client_entity"]["description"]
    for rc in d.get("render_controllers", []):
        if rc not in KTRL and not rc.startswith("controller.render.default"):
            bad.append(f"{os.path.basename(f)}: renderarkontrollern {rc} finns inte")
# APPORTBARA står på två ställen (skriptet kan inte läsa entitets-JSON). Glider
# de isär går hunden fram till en pinne som skriptet sedan struntar i.
gen = open(f"{SRC}/tools/make_dogs.py").read()
js = open(f"{SRC}/LoyalCompanions_BP/scripts/main.js").read()
g1 = set(re.findall(r'"([a-z:_]+)"', re.search(r"APPORTBARA = \[(.*?)\]", gen, re.S).group(1)))
g1 |= {"hund:boll"} if 'f"{NS}:boll"' in gen else set()
g2 = set(re.findall(r'"([a-z:_]+)":', re.search(r"APPORTBARA = \{(.*?)\}", js, re.S).group(1)))
if g1 != g2: bad.append(f"APPORTBARA skiljer: generatorn {sorted(g1)} mot skriptet {sorted(g2)}")
# TVÅ MÅL MED SAMMA PRIORITET är odefinierat i Bedrock — det ena kan tyst falla
# bort. Krocken syns bara i KOMBINATIONEN av grupper som är aktiva samtidigt,
# och stay_while_sitting låg på samma siffra som melee_attack: en sittande
# vakthund var ett lotteri.
KOMBOR = [("hund:tamed", "hund:foljer"), ("hund:tamed", "hund:stannar"),
          ("hund:tamed", "hund:vaktar"), ("hund:tamed", "hund:foljer", "hund:apporterar"),
          ("hund:tamed", "hund:vaktar", "hund:apporterar")]
# TVÅ KOMPONENTGRUPPER SOM DEKLARERAR SAMMA KOMPONENT får inte vara aktiva
# samtidigt. hund:vuxen och hund:valp sätter båda minecraft:scale, och
# parningens hund:fodd la på valpen UTAN att ta bort vuxen — vilken skala som
# vann var odefinierat och valpen kunde födas fullvuxen.
for f in glob.glob(f"{SRC}/LoyalCompanions_BP/entities/*.json"):
    e = json.load(open(f))["minecraft:entity"]
    namn = os.path.basename(f)
    grupper = e["component_groups"]
    for kombo in KOMBOR:
        prio = {}
        for g in kombo:
            for k, v in grupper.get(g, {}).items():
                if k.startswith("minecraft:behavior.") and isinstance(v, dict):
                    prio.setdefault(v.get("priority"), []).append(f"{g}/{k}")
        for k, v in e["components"].items():
            if k.startswith("minecraft:behavior.") and isinstance(v, dict):
                prio.setdefault(v.get("priority"), []).append(f"bas/{k}")
        for p_, vilka in sorted(prio.items(), key=lambda x: (x[0] is None, x[0])):
            if len(vilka) > 1:
                bad.append(f"{namn}: prioritet {p_} delas av {', '.join(vilka)} "
                           f"i {'+'.join(kombo)}")
    for ev, kropp in e["events"].items():
        lagg = kropp.get("add", {}).get("component_groups", [])
        tas = set(kropp.get("remove", {}).get("component_groups", []))
        for i2, a in enumerate(lagg):
            for b in lagg[i2 + 1:]:
                delade = set(grupper.get(a, {})) & set(grupper.get(b, {}))
                if delade:
                    bad.append(f"{namn}: {ev} lägger på både {a} och {b}, som båda "
                               f"sätter {', '.join(sorted(delade))}")
        # grupper som krockar med en påslagen grupp måste tas bort i samma händelse
        # minecraft:entity_spawned undantas: den kör EN gång, i samma ögonblick
        # som djuret skapas, innan någon annan grupp hunnit läggas på. Den kan
        # alltså inte krocka med en grupp som redan sitter där. (Parningens
        # ordning bygger på just det: ungen spawnar, entity_spawned lägger på
        # hund:vuxen, och därefter tar breed_event hund:fodd bort den igen.)
        if ev == "minecraft:entity_spawned":
            continue
        for a in lagg:
            for b, bk in grupper.items():
                if b == a or b in tas or b in lagg:
                    continue
                delade = set(grupper.get(a, {})) & set(bk)
                # bara grupper som något annat event faktiskt kan ha slagit på
                pas = any(b in x.get("add", {}).get("component_groups", [])
                          for x in e["events"].values())
                if delade and pas:
                    bad.append(f"{namn}: {ev} lägger på {a} utan att ta bort {b} "
                               f"— båda sätter {', '.join(sorted(delade))}")
# BIOMTAGGEN MÅSTE FINNAS. "mountain" ser rimlig ut, heter "extreme_hills" och
# ger en ras som helt enkelt aldrig dyker upp i världen — utan ett ord någonstans.
# Facit är vaniljas BIOMDEFINITIONER, inte dess spawnregler: taggar som
# "forest" är fullt giltiga men används inte av någon vanilla-regel, och en
# lista dragen ur spawnreglerna underkände dem.
VANILJ = "/opt/bds/server/behavior_packs/vanilla/biomes"
if os.path.isdir(VANILJ):
    kanda = set()
    for f in glob.glob(f"{VANILJ}/*.json"):
        b = json.load(open(f))["minecraft:biome"]
        kanda |= set(b.get("components", {}).get("minecraft:tags", {}).get("tags")
                     or b.get("description", {}).get("tags") or [])
    for f in glob.glob(f"{SRC}/LoyalCompanions_BP/spawn_rules/*.json"):
        d = json.load(open(f))["minecraft:spawn_rules"]
        for v in d["conditions"]:
            t = v.get("minecraft:biome_filter", {}).get("value")
            if t and t not in kanda:
                bad.append(f"{os.path.basename(f)}: biomtaggen '{t}' finns inte i vanilla")
# VARJE VANILLA-FÖREMÅL VI NÄMNER MÅSTE FINNAS. Ett felstavat id i grävlistan
# kastar vid körning; i healable, breed_items eller ett recept tystnar det bara
# och funktionen finns inte. Facit är vaniljas hantverkskatalog.
KAT = "/opt/bds/server/behavior_packs/vanilla/item_catalog/crafting_item_catalog.json"
if os.path.exists(KAT):
    kanda = set(re.findall(r'"(minecraft:[a-z0-9_]+)"', open(KAT).read()))
    egna = {f"hund:{os.path.basename(f)[:-5]}"
            for f in glob.glob(f"{SRC}/LoyalCompanions_BP/items/*.json")}
    n = lambda i: i if ":" in i else "minecraft:" + i
    nas = {}
    js = open(f"{SRC}/LoyalCompanions_BP/scripts/main.js").read()
    m = re.search(r"const SKATT = \[(.*?)\];", js, re.S)
    if m:
        for i in re.findall(r'"(minecraft:[a-z0-9_]+)"', m.group(1)):
            nas.setdefault(i, "grävlistan")
    for f in glob.glob(f"{SRC}/LoyalCompanions_BP/entities/*.json"):
        e = json.load(open(f))["minecraft:entity"]
        c, g = e["components"], e["component_groups"]
        for i in c.get("minecraft:shareables", {}).get("items", []):
            nas.setdefault(n(i["item"]), "shareables")
        for i in c.get("minecraft:tameable", {}).get("tame_items", []):
            nas.setdefault(n(i), "tame_items")
        for grp, nyckel in (("hund:tamed", "minecraft:healable"),
                            ("hund:parar", "minecraft:breedable"),
                            ("hund:valp", "minecraft:ageable")):
            komp = g.get(grp, {}).get(nyckel, {})
            for falt in ("items", "breed_items", "feed_items"):
                for i in komp.get(falt, []):
                    nas.setdefault(n(i["item"] if isinstance(i, dict) else i), falt)
        for x in g.get("hund:tamed", {}).get("minecraft:interact", {}).get("interactions", []):
            for v in re.findall(r'"value": "([a-z_]+_dye|bone)"',
                                json.dumps(x.get("on_interact", {}).get("filters", {}))):
                nas.setdefault(n(v), "interact")
    for f in glob.glob(f"{SRC}/LoyalCompanions_BP/recipes/*.json"):
        b = next(v for k, v in json.load(open(f)).items() if k.startswith("minecraft:recipe"))
        for v in list(b.get("key", {}).values()) + b.get("ingredients", []) + b.get("unlock", []):
            nas.setdefault(n(v["item"] if isinstance(v, dict) else v), os.path.basename(f))
    for i, var in sorted(nas.items()):
        if i not in kanda and i not in egna:
            bad.append(f"okänt föremål '{i}' i {var}")
# RECEPTKROCKAR mot vanilla. Två recept med samma rutnät gör att det ena inte
# går att tillverka — kattpaketets katt-byxor var vaniljas läderbyxor.
VR = "/opt/purrfect-companions/tests/vanilla-recipes.json"
if os.path.exists(VR):
    sys.path.insert(0, "/opt/purrfect-companions")
    from recipe_canon import canon
    facit = set(json.load(open(VR)))
    sedda = {}
    for f in glob.glob(f"{SRC}/LoyalCompanions_BP/recipes/*.json"):
        b = next(v for k, v in json.load(open(f)).items() if k.startswith("minecraft:recipe"))
        sig = canon(b)
        namn = os.path.basename(f)
        if not sig:
            bad.append(f"{namn}: receptet har varken pattern eller ingredients")
        elif sig in facit:
            bad.append(f"{namn}: samma rutnät som ett vaniljrecept")
        elif sig in sedda:
            bad.append(f"{namn}: samma rutnät som {sedda[sig]}")
        else:
            sedda[sig] = namn
# VARJE NYCKEL SOM VISAS FÖR SPELAREN MÅSTE FINNAS I ALLA SPRÅK. Spelaren ser
# annars den råa nyckeln ("hund.vissla.kom") mitt i skärmen. Visslan saknade
# faktiskt sin item-rad i en_US ända fram till genomgången — föremålets
# minecraft:display_name räddade den, men bara på engelska.
sprak = json.load(open(f"{SRC}/LoyalCompanions_RP/texts/languages.json"))
texter = {s: open(f"{SRC}/LoyalCompanions_RP/texts/{s}.lang", encoding="utf-8").read()
          for s in sprak}
kravs = set()
for f in glob.glob(f"{SRC}/LoyalCompanions_BP/entities/*.json"):
    e = json.load(open(f))["minecraft:entity"]
    ident = e["description"]["identifier"]
    kravs |= {f"entity.{ident}.name", f"item.spawn_egg.entity.{ident}.name"}
    for x in e["component_groups"].get("hund:tamed", {}).get(
            "minecraft:interact", {}).get("interactions", []):
        if x.get("interact_text"):
            kravs.add(x["interact_text"])
for f in glob.glob(f"{SRC}/LoyalCompanions_BP/items/*.json"):
    kravs.add("item." + json.load(open(f))["minecraft:item"]["description"]["identifier"] + ".name")
js = open(f"{SRC}/LoyalCompanions_BP/scripts/main.js").read()
kravs |= set(re.findall(r'"(hund\.[a-z0-9_.]+)"', js))
for k in re.findall(r'LAGENAMN = \[(.*?)\]', js, re.S):
    kravs |= set(re.findall(r'"(hund\.[a-z0-9_.]+)"', k))
for s2 in sprak:
    for k in sorted(kravs):
        if f"{k}=" not in texter[s2]:
            bad.append(f"{s2}.lang saknar nyckeln '{k}'")
# BP och RP ska ha samma texter — spelet läser RP:s, men en BP-fil som glidit
# isär är en fälla nästa gång någon redigerar fel kopia.
for s2 in sprak:
    if open(f"{SRC}/LoyalCompanions_BP/texts/{s2}.lang", encoding="utf-8").read() != texter[s2]:
        bad.append(f"{s2}.lang skiljer mellan BP och RP")
print("\n".join(bad))
PY
)
if [ -n "$STRUKT" ]; then
  echo "$STRUKT" | while read -r l; do [ -n "$l" ] && echo "  ❌ $l"; done
  FAIL=1
else
  ok "manifest och motorkrav, geometri mot PNG, bennamn mot animationer, renderarkontroller, spawnägg, biomtaggar, föremåls-id, receptkrockar, språknycklar i båda språken"
fi

echo
echo "[3/3] Skarp server (~1 min)"
pkill -9 -x bedrock_server 2>/dev/null; sleep 2
find "$SRV" -name "ContentLog*" -delete 2>/dev/null
rm -rf "$WORLD/db" "$WORLD/behavior_packs" "$WORLD/resource_packs"
mkdir -p "$WORLD/behavior_packs" "$WORLD/resource_packs"
cp -r "$SRC/LoyalCompanions_BP" "$WORLD/behavior_packs/"
cp -r "$SRC/LoyalCompanions_RP" "$WORLD/resource_packs/"
python3 - "$WORLD" <<'PY'
import json, sys
W = sys.argv[1]
bp = json.load(open(f"{W}/behavior_packs/LoyalCompanions_BP/manifest.json"))["header"]
rp = json.load(open(f"{W}/resource_packs/LoyalCompanions_RP/manifest.json"))["header"]
json.dump([{"pack_id": bp["uuid"], "version": bp["version"]}], open(f"{W}/world_behavior_packs.json", "w"))
json.dump([{"pack_id": rp["uuid"], "version": rp["version"]}], open(f"{W}/world_resource_packs.json", "w"))
PY
sed -i 's/^level-name=.*/level-name=Hundtest/' "$SRV/server.properties"
cd "$SRV" || exit 1
{
  sleep 28
  echo "tickingarea add 0 0 0 48 48 48 hund"; sleep 3
  # MARK OCH LUFTFICKA FÖRST. Utan dem dör hunden inom en sekund — testvärlden
  # är inte platt vid y=20, och en summonad hund faller eller kvävs. Felet såg
  # ut som att tämjningen inte fungerade (0/3), men första testfor hittade
  # hunden och eventet en sekund senare hade inga mål: djuret var borta, inte
  # otämjt. Samma fälla som kattpaketets vakuumtest gick i.
  # ARENAN MÅSTE RYMMA APPORTEN. Första försöket grävde 6..14 och lade sedan
  # bollen åtta block bort på x=18 — utanför fickan, nere i berget. Testet sa
  # "hunden hämtade inte bollen" när bollen aldrig var åtkomlig.
  # ARENAN ÄR EN KORRIDOR, inte en kub: visseltestet flyttar hunden trettio
  # block bort och den måste stå på mark hela vägen. Hamnar den i berget dör
  # den, och testet rapporterar "visslan hämtade inte hem hunden" när det som
  # hände var att hunden kvävdes.
  echo "fill 2 19 2 46 19 22 stone"; sleep 1
  echo "fill 2 20 2 46 26 22 air"; sleep 1
  for r in $RASER; do
    echo "summon hund:$r 10 21 10"; sleep 2
    echo "event entity @e[type=hund:$r] hund:on_tame"; sleep 1
    echo "testfor @e[type=hund:$r,x=10,y=21,z=10,r=30,has_property={hund:tam=1}]"; sleep 1
    echo "kill @e[type=hund:$r]"; sleep 1
  done
  # LÄGESVÄXLINGEN: följer -> stannar -> vaktar -> följer.
  #
  # Testhunden får ett NAMN och väljs på det. Först användes "say MARKOR" som
  # skiljelinje i loggen — men serverns say skrivs aldrig dit, så räkningen
  # startade aldrig och steget rapporterade 0/4 fast mekaniken fungerade.
  # Ett namn ger en egen rad ("Found Lagetest") som inte kan förväxlas med
  # tämjningens träffar.
  echo "summon hund:rufus \"Lagetest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Lagetest] hund:on_tame"; sleep 1
  echo "testfor @e[name=Lagetest,has_property={hund:lage=0}]"; sleep 1
  for v in 1 2 0; do
    echo "event entity @e[name=Lagetest] hund:nasta_lage"; sleep 1
    echo "testfor @e[name=Lagetest,has_property={hund:lage=$v}]"; sleep 1
  done
  echo "kill @e[name=Lagetest]"; sleep 1
  # APPORTEN. En simulerad spelare kan inte kasta en boll, så skriptkroken
  # lägger den på marken tre block bort och svarar om den hamnat i hundens mun.
  # Det som ska bevisas är att hunden GÅR DIT SJÄLV: skript-API:t kan inte
  # sätta ett mål för en entitet, hela mekaniken vilar på att pickup_items
  # sköter navigeringen.
  echo "summon hund:rufus \"Apporttest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Apporttest] hund:on_tame"; sleep 2
  echo "scriptevent hund:test_apport kor"; sleep 20
  echo "testfor @e[name=Apporttest,has_property={hund:bar=1}]"; sleep 1
  echo "kill @e[name=Apporttest]"; sleep 1
  # VALPEN. Parningen själv går inte att köra utan två hundar i kärlekshumör
  # och en spelare med kött, men det parningen SLUTAR med — hund:fodd på ungen
  # — går att prova direkt, och det är där felen sitter: en valp som föds otämjd
  # eller som aldrig växer upp.
  echo "summon hund:pepper \"Valptest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Valptest] hund:fodd"; sleep 1
  echo "testfor @e[name=Valptest,has_property={hund:tam=1}]"; sleep 1
  echo "event entity @e[name=Valptest] hund:grow_up"; sleep 1
  echo "testfor @e[name=Valptest,has_property={hund:tam=1}]"; sleep 1
  echo "kill @e[name=Valptest]"; sleep 1
  # HALSBANDET. Färgen är en egenskap som renderarkontrollern läser; att den
  # SYNS går inte att prova här, men att den sätts gör det.
  echo "summon hund:dot \"Halstest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Halstest] hund:on_tame"; sleep 1
  echo "event entity @e[name=Halstest] hund:halsband_5"; sleep 1
  echo "testfor @e[name=Halstest,has_property={hund:halsband=5}]"; sleep 1
  echo "kill @e[name=Halstest]"; sleep 1
  # VISSLAN och GRÄVANDET. Båda utlöses normalt av en spelare, som testet inte
  # har; krokarna kör samma funktioner med en plats i stället.
  echo "summon hund:kelda \"Visseltest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Visseltest] hund:on_tame"; sleep 1
  echo "event entity @e[name=Visseltest] hund:nasta_lage"; sleep 1
  echo "scriptevent hund:test_vissla kor"; sleep 6
  echo "testfor @e[name=Visseltest,has_property={hund:lage=0}]"; sleep 1
  echo "scriptevent hund:test_grav kor"; sleep 4
  echo "scriptevent hund:test_foremal kor"; sleep 3
  echo "kill @e[name=Visseltest]"; sleep 1
  # STANNAKOMMANDOT mot en boll åtta block bort.
  echo "summon hund:scout \"Stannatest\" 10 21 10"; sleep 2
  echo "event entity @e[name=Stannatest] hund:on_tame"; sleep 1
  echo "event entity @e[name=Stannatest] hund:nasta_lage"; sleep 1
  echo "testfor @e[name=Stannatest,has_property={hund:lage=1}]"; sleep 1
  echo "scriptevent hund:test_stanna kor"; sleep 14
  echo "kill @e[name=Stannatest]"; sleep 1
  # Bollarna som blivit kvar städas bort, annars kan nästa steg i en framtida
  # utökning tro att de är dess egna.
  echo "kill @e[type=item]"; sleep 1
  sleep 2; echo "stop"; sleep 8
} | LD_LIBRARY_PATH=. ./bedrock_server > "$LOG" 2>&1
pkill -9 -x bedrock_server 2>/dev/null

LOADED=$(grep -c "Pack Stack.*Loyal Companions" "$LOG")
SUM=$(grep -c "Object successfully summoned" "$LOG")
TAM=$(grep -c "Found entity.hund:" "$LOG")
HARD=$(grep -ciE "Syntax error|unknown component|invalid" "$LOG")
LAGE=$(grep -c "Found Lagetest" "$LOG")
APPORT=$(grep -c "Found Apporttest" "$LOG")
VALP=$(grep -c "Found Valptest" "$LOG")
HALS=$(grep -c "Found Halstest" "$LOG")
VISSEL=$(grep -c "VISSEL-TEST OK" "$LOG")
GRAV=$(grep -c "GRAV-TEST OK" "$LOG")
FOREMAL=$(grep -c "FOREMAL-TEST OK" "$LOG")
STANNA=$(grep -c "STANNA-TEST OK" "$LOG")
LAGEATER=$(grep -c "Found Visseltest" "$LOG")
CL=$(find "$SRV" -name "ContentLog*" 2>/dev/null | head -1)
[ "$LOADED" -ge 1 ] && ok "paketet laddades" || bad "paketet laddades INTE"
[ "$SUM" -ge "$ANTAL" ] && ok "alla raser spawnar ($SUM/$ANTAL: $RASER)" || bad "bara $SUM/$ANTAL spawnade"
[ "$TAM" -ge "$ANTAL" ] && ok "tämjningen sätter hund:tam ($TAM/$ANTAL, has_property)" || bad "bara $TAM/$ANTAL blev tämjda"
[ "$LAGE" -ge 4 ] && ok "kommandolägena växlar: följer -> stannar -> vaktar -> följer ($LAGE/4)" || bad "lägesväxlingen gav $LAGE/4"
[ "$APPORT" -ge 1 ] && ok "apporten: hunden hämtar bollen själv (pickup_items navigerar)" || bad "hunden hämtade INTE bollen (se APPORT-TEST i $LOG)"
[ "$VALP" -ge 2 ] && ok "valpen föds tämjd och växer upp ($VALP/2)" || bad "valpkedjan gav $VALP/2"
[ "$HALS" -ge 1 ] && ok "halsbandet sätter hund:halsband" || bad "halsbandet sattes inte"
[ "$VISSEL" -ge 1 ] && ok "visslan kallar hem hunden" || bad "visslan hämtade inte hem hunden"
[ "$LAGEATER" -ge 1 ] && ok "visslan sätter hunden i följaläge igen" || bad "hunden stod kvar i fel läge efter visslan"
[ "$FOREMAL" -ge 1 ] && ok "boll och vissla är registrerade föremål" || bad "något av våra egna föremål gick inte att skapa"
[ "$STANNA" -ge 1 ] && ok "stannakommandot håller även när en boll ligger framme" || bad "hunden i stannaläge gick efter bollen"
[ "$GRAV" -ge 1 ] && ok "hunden gräver upp något" || bad "grävandet gav inget fynd"
[ "$HARD" -eq 0 ] && ok "inga syntax-/komponentfel" || bad "$HARD allvarliga fel (se $LOG)"
# VISA DE RADER SOM FÄLLDE KÖRNINGEN, inte filens första fyra. Den gamla
# utskriften visade [inform]-rader som passerat grinden medan den riktiga
# varningen låg längre ner — det såg ut som att kvittona var felet.
CLREST=""
[ -n "$CL" ] && CLREST=$(grep -v '^[[:space:]]*$' "$CL" | grep -v '\[Scripting\]\[inform\]' || true)
if [ -n "$CLREST" ]; then
  bad "innehållsfel i $(basename "$CL")"; echo "$CLREST" | head -5 | sed 's/^/     /'
else ok "inga innehållsfel"; fi

echo
[ $FAIL -eq 0 ] && echo "=== LOYAL COMPANIONS GRÖNT ===" || echo "=== FEL HITTADE (logg: $LOG) ==="
exit $FAIL
